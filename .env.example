# zk-trial frontend configuration (Midnight Preprod).
#
# Copy this file to .env.local for local development, or set the same
# variables in your hosting provider's dashboard (e.g. Vercel).
#
# SECURITY: every variable below is NEXT_PUBLIC_* and is therefore embedded in
# the browser bundle. A contract address, indexer URL and network id are
# public information by design.
#
# NEVER add a private key, secret key, seed phrase, or mnemonic here. The
# frontend NEVER signs with a server-held key — proving, balancing and
# submission are all performed through the participant's own 1AM Wallet in
# the browser. There is no server-side signer in this project.

# --- Midnight network -------------------------------------------------------
# The one network zk-trial targets. Keep in sync with src/midnight/config.ts.
NEXT_PUBLIC_MIDNIGHT_NETWORK=preprod

# --- Deployed zk-trial Compact contract address ----------------------------
# Set this AFTER deploying through the sponsor dashboard (1AM Wallet ->
# "Deploy to Midnight Preprod"). Leave empty to show the honest
# "not deployed yet" state. Recorded deployments are printed by the deploy
# panel and can also be pasted here for all visitors.
NEXT_PUBLIC_ZKTRIAL_CONTRACT_ADDRESS=

# --- Optional overrides -----------------------------------------------------
# ZK artifacts (prover/verifier keys, zkIR) are served from /zk by the app
# itself; override only if you host them on a CDN instead.
# NEXT_PUBLIC_ZK_ASSETS_BASE_URL=

# HTTP proof server fallback used ONLY if the connected wallet does not
# expose its own proving provider. 1AM Wallet always exposes one, so this
# normally stays empty.
# NEXT_PUBLIC_PROOF_SERVER_URL=
