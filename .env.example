# zk-trial frontend configuration.
#
# Copy this file to apps/web/.env.local for local development, or set the same
# variables in your hosting provider's dashboard.
#
# SECURITY: every variable below is NEXT_PUBLIC_* and is therefore embedded in
# the browser bundle. A Soroban contract ID, RPC URL and network passphrase are
# public information by design.
#
# NEVER add a private key, secret key, seed phrase, or mnemonic here. The
# frontend NEVER signs with a server-held key -- signing is done by the
# participant's own Freighter browser wallet. There is no server-side signer in
# this project, so there is no secret for the frontend to hold.

# --- Public Soroban RPC endpoint ---------------------------------------------
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# --- Network passphrase (public; identifies which network to sign for) ------
NEXT_PUBLIC_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# --- Human-readable network name shown in the UI ---------------------------
NEXT_PUBLIC_NETWORK_LABEL=Stellar Testnet

# --- Deployed zk-trial Soroban contract ------------------------------------
# Deployed with scripts/deploy-preprod.sh. Recorded in deployment/preprod.json.
NEXT_PUBLIC_CONTRACT_ID=CCWXE7V7UU72S4EPCY54WWMQDXLHUTJLC33MXE6IO4KX6IOQAKTRV55F

# --- Explorer base URL used to build transaction / contract links ----------
NEXT_PUBLIC_STELLAR_EXPLORER_URL=https://stellar.expert/explorer/testnet
